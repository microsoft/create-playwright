    "test": "playwright test",
    "prepublish": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0-alpha-2026-08-17",
    "@types/ini": "^4.1.1",
    "@types/node": "^20.19.43",
    "ansi-colors": "^4.1.1",
    "commander": "^14.0.1",
    "enquirer": "^2.3.6",
    "esbuild": "^0.28.1",
    "ini": "^4.1.3",
    "typescript": "^6.0.3"
  }
}
